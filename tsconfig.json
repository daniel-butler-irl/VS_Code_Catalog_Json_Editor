{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,/* Skip type checking of declaration files to avoid lru-cache issues */
    "forceConsistentCasingInFileNames": true,
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node", "vscode", "jest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "composite": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "out",
    "src/test/suite/**/*"
  ],
  "include": [
    "src/**/*"
  ],
  "references": [
    { "path": "./tsconfig.jest.json" }
  ]
}